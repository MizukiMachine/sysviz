flowchart LR
    subgraph Source["Source Definitions / Source Definitions"]
        direction TB
        RouteDefs["Route decorators<br/>@app.get() @app.post() etc."]
        TypeHints["Python type hints<br/>str, int, list[Item] etc."]
        PydanticModels["Pydantic BaseModel<br/>response_model, Request body"]
        ParamFuncs["Parameter functions<br/>Query, Path, Body, Form, File"]
        SecurityDefs["Security dependencies<br/>OAuth2, APIKey, HTTPBasic"]
        Docstrings["Function docstrings<br/>Endpoint descriptions"]
    end

    subgraph Extraction["Schema Extraction / Schema Extraction (openapi/utils.py)"]
        direction TB
        PathAnalysis["Analyze path operations<br/>Extract routes from APIRouter"]
        ParamAnalysis["Analyze parameters<br/>Extract path/query/body params"]
        BodyAnalysis["Analyze request body<br/>Pydantic model -> JSON Schema"]
        ResponseAnalysis["Analyze response model<br/>return type -> JSON Schema"]
        SecurityAnalysis["Analyze security schemes<br/>OAuth2 flows, API keys"]
        ExampleExtraction["Extract examples<br/>From param definitions"]
    end

    subgraph Generation["OpenAPI Schema Generation / OpenAPI Schema Generation"]
        direction TB
        BuildPaths["Build /paths object<br/>Each route -> OpenAPI operation"]
        BuildComponents["Build /components/schemas<br/>Pydantic models -> JSON Schema"]
        BuildSecurity["Build /components/securitySchemes<br/>Security scheme definitions"]
        BuildInfo["Build /info object<br/>title, description, version"]
        Assemble["Assemble full OpenAPI 3.1<br/>Combine all sections"]
    end

    subgraph Output["Output / Output"]
        direction TB
        JSONSchema["JSON Schema 2020-12<br/>Validation schemas"]
        OpenAPI31["OpenAPI 3.1.0 spec<br/>Full API specification"]
        SwaggerUI["Swagger UI (/docs)<br/>Interactive API docs"]
        ReDoc["ReDoc (/redoc)<br/>Alternative API docs"]
    end

    subgraph RuntimeFlow["Runtime Validation / Runtime Validation"]
        direction TB
        RequestIn["Incoming request"]
        ValidateRequest["Pydantic validates<br/>body/params against schema"]
        Endpoint["Endpoint processes<br/>validated data"]
        ValidateResponse["Pydantic serializes<br/>response to JSON"]
        ResponseOut["JSON response"]
    end

    Source -->|"introspection at<br/>app startup"| Extraction
    Extraction -->|"structured data"| Generation
    Generation -->|"JSON output"| Output
    Generation -.->|"validation schemas<br/>used at runtime"| RuntimeFlow

    RouteDefs --> PathAnalysis
    TypeHints --> ParamAnalysis
    PydanticModels --> BodyAnalysis
    PydanticModels --> ResponseAnalysis
    ParamFuncs --> ParamAnalysis
    SecurityDefs --> SecurityAnalysis

    PathAnalysis --> BuildPaths
    ParamAnalysis --> BuildPaths
    BodyAnalysis --> BuildComponents
    ResponseAnalysis --> BuildComponents
    SecurityAnalysis --> BuildSecurity
    Docstrings --> BuildPaths

    BuildPaths --> Assemble
    BuildComponents --> Assemble
    BuildSecurity --> Assemble
    BuildInfo --> Assemble

    Assemble --> JSONSchema
    Assemble --> OpenAPI31
    OpenAPI31 --> SwaggerUI
    OpenAPI31 --> ReDoc

    RequestIn --> ValidateRequest
    ValidateRequest --> Endpoint
    Endpoint --> ValidateResponse
    ValidateResponse --> ResponseOut

