flowchart TB
    Client["[Client] HTTP Client<br/>Browser / API Client / curl"]

    subgraph ASGILayer["ASGI Server Layer / ASGI Server Layer"]
        direction LR
        Uvicorn["Uvicorn<br/>ASGI Server"]
        Hypercorn["Hypercorn<br/>ASGI Server"]
    end

    subgraph StarletteLayer["Starlette Foundation Layer / Starlette Foundation Layer"]
        direction LR
        StarletteApp["[Core] Starlette Application<br/>HTTP/WS handling base"]
        StarletteRouting["[Router] Starlette Routing<br/>URL pattern matching"]
        StarletteMiddleware["[Middleware] Starlette Middleware<br/>CORS / Errors / Sessions"]
        StarletteReqResp["[I/O] Request & Response<br/>HTTP request/response objects"]
    end

    subgraph FastAPILayer["FastAPI Core Layer / FastAPI Core Layer"]
        direction LR
        FastAPIApp["[App] FastAPI Class<br/>Main application entry"]
        Router["[Router] APIRouter<br/>Route registration & grouping"]
        DependencySystem["[DI] Dependency Injection<br/>Depends / Security"]
        ParamExtraction["[Params] Parameter Extraction<br/>Path / Query / Header / Cookie / Body"]
    end

    subgraph ValidationLayer["Validation & Serialization Layer / Validation & Serialization Layer"]
        direction LR
        PydanticValidation["[Validator] Pydantic<br/>Request validation & serialization"]
        OpenAPIGen["[Schema] OpenAPI Generator<br/>Auto-generated API docs"]
        TypeHints["[Types] Python Type Hints<br/>Type-annotated parameters"]
    end

    subgraph UserLayer["User Application Layer / User Application Layer"]
        direction LR
        Endpoints["[Endpoint] Path Operations<br/>app.get() / app.post() etc."]
        Models["[Model] Pydantic Models<br/>Request/response schemas"]
        Deps["[Deps] User Dependencies<br/>DB sessions / Auth / Config"]
    end

    Client --> ASGILayer
    ASGILayer --> StarletteLayer
    StarletteLayer --> FastAPILayer
    FastAPILayer --> ValidationLayer
    ValidationLayer --> UserLayer
    UserLayer -.->|"type annotations"| ValidationLayer
    UserLayer -.->|"Depends()"| FastAPILayer

