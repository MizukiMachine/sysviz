%%{init: {'theme': 'base', 'themeVariables': {
  'primaryColor': '#AED6F1',
  'primaryTextColor': '#333',
  'primaryBorderColor': '#5DADE2',
  'lineColor': '#85929E'
}}}%%
flowchart LR
    subgraph Input["Input / 入力"]
        Client["[User] Client<br/>Browser / HTTP Client<br/>ブラウザ/HTTPクライアント"]
        CLIInput["[CLI] Terminal<br/>flask run / flask shell<br/>コマンドライン"]
    end

    subgraph Entry["Entry Point / エントリーポイント"]
        WSGICall["[Entry] Flask.__call__<br/>WSGI Application<br/>WSGIアプリケーション"]
        CLIEntry["[Entry] FlaskGroup<br/>Click Command<br/>Clickコマンド"]
    end

    subgraph ContextSetup["Context Setup / コンテキスト設定"]
        PushCtx["[Ctx] push AppContext<br/>Create Context<br/>コンテキスト作成"]
        BindReq["[Ctx] Bind Request<br/>LocalProxy Setup<br/>LocalProxy設定"]
    end

    subgraph Middleware["Middleware / ミドルウェア"]
        BeforeReq["[Hook] before_request<br/>Pre-processing Hooks<br/>前処理フック"]
        URLMatch["[Router] url_map.match<br/>URL Rule Resolution<br/>URLルール解決"]
    end

    subgraph Processing["Processing / 処理"]
        ViewFunc["[View] View Function<br/>User-defined Handler<br/>ユーザー定義ハンドラ"]
        ErrorHandler["[Error] handle_exception<br/>Error Processing<br/>エラー処理"]
    end

    subgraph Response["Response / レスポンス"]
        MakeRes["[Resp] make_response<br/>Build Response Object<br/>レスポンスオブジェクト構築"]
        AfterReq["[Hook] after_request<br/>Post-processing Hooks<br/>後処理フック"]
        SessionSave["[Session] save_session<br/>Persist Session Data<br/>セッションデータ永続化"]
    end

    subgraph Output["Output / 出力"]
        HTTPResp["[Output] HTTP Response<br/>Status + Headers + Body<br/>ステータス+ヘッダー+ボディ"]
        CLIOutput["[Output] CLI Result<br/>Console Output<br/>コンソール出力"]
    end

    subgraph Cleanup["Cleanup / クリーンアップ"]
        TdownReq["[Cleanup] teardown_request<br/>Request Cleanup<br/>リクエストクリーンアップ"]
        PopCtx["[Cleanup] pop AppContext<br/>Context Teardown<br/>コンテキスト破棄"]
    end

    %% HTTP Request Flow
    Client --> WSGICall
    WSGICall --> PushCtx
    PushCtx --> BindReq
    BindReq --> BeforeReq
    BeforeReq --> URLMatch
    URLMatch --> ViewFunc
    ViewFunc --> MakeRes
    ViewFunc -->|error| ErrorHandler
    ErrorHandler --> MakeRes
    MakeRes --> AfterReq
    AfterReq --> SessionSave
    SessionSave --> TdownReq
    TdownReq --> PopCtx
    PopCtx --> HTTPResp

    %% CLI Flow
    CLIInput --> CLIEntry
    CLIEntry --> PushCtx
    CLIEntry --> CLIOutput

