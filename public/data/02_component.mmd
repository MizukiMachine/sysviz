    style TemplateEngine fill:#FAD7A0,stroke:#C68A00,color:#333
    style SessionManagement fill:#D7BDE2,stroke:#8E44AD,color:#333
    style JSONHandling fill:#F9E79F,stroke:#D4AC00,color:#333
    style CLI fill:#AED6F1,stroke:#5DADE2,color:#333
    style TestingSupport fill:#A9DFBF,stroke:#52BE80,color:#333
    style Signals fill:#F5CBA7,stroke:#E67E22,color:#333

